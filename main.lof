\contentsline {figure}{\numberline {8.3}{\ignorespaces flow-cell schematic and assembled flow-cell photograph.}}{76}{figure.caption.48}%
\contentsline {figure}{\numberline {8.4}{\ignorespaces Convex-lens induced confinement schematic. Two glass coverslips, separated by a $\SI {30}{\micro \meter }$ spacer are confined with a convex-lens pusher. The height between the coverslips is voltage-regulated to nanometer precision. Nanoparticle of radius $\SI {50}{\nm }$ pictured for reference.}}{78}{figure.caption.49}%
\contentsline {figure}{\numberline {8.5}{\ignorespaces DLS results for Polystyrene beads in MilliQ water.}}{78}{figure.caption.50}%
\contentsline {figure}{\numberline {8.6}{\ignorespaces Spatial density of the average trajectory of particles. }}{80}{figure.caption.53}%
\contentsline {figure}{\numberline {8.7}{\ignorespaces Probability density for three different concentrations of PBS. The blue line has a concentration of $0.1\%$ PBS, green has a concentration of $0.01\%$ PBS, and orange has a concentration of $0.00001\%$ PBS. The horizontal axis is the $z$-axis position of the particle. The vertical axis is the frequency of position measurement.}}{81}{figure.caption.54}%
\contentsline {figure}{\numberline {8.8}{\ignorespaces Relationship between the FWHM and $a_{xy}$, where FWHM is the full-width half maximum of the positional histogram, and $a_{xy}$ is the particle radius.}}{82}{figure.caption.55}%
\contentsline {figure}{\numberline {8.9}{\ignorespaces Plotted is the radius estimated by axial exploration compared to inferred transverse size of particles for various ionic concentrations. }}{83}{figure.caption.56}%
\contentsline {figure}{\numberline {8.10}{\ignorespaces Surface charge estimation via MLE of $\SI {100}{\nm }$ polystyrene beads in 0.00001\% PBS solution. Imaging conducted at $\SI {400}{\fps }$.}}{84}{figure.caption.57}%
\contentsline {figure}{\numberline {8.11}{\ignorespaces Glycerol-water curve. The theoretical line plotted is used from Cheng et al. \blx@tocontentsinit {0}\cite {cheng_formula_2008}.}}{85}{figure.caption.59}%
\contentsline {figure}{\numberline {8.12}{\ignorespaces Trajectory of a polystrene bead in glycerol. The red dot and blue square show the initial and final position respectfully.}}{86}{figure.caption.60}%
\contentsline {figure}{\numberline {8.13}{\ignorespaces Mean-squared displacement of glycerol-slowed polystyrene beads. Axial MSD is clearly convergent to the confinement length. The confinement length is fixed at $225$ nm and the particle's estimated size is $a=\SI {50}{\nm }$. The lag time, $\tau $ is plotted in frame indices. Each unit of $\tau $ represents one frame at $\SI {580}{\fps }$.}}{87}{figure.caption.61}%
\contentsline {figure}{\numberline {8.14}{\ignorespaces Theoretical diffusivity shown in orange using the linear-superposition theory (LST). Measured diffusivity of $7$ particle traces are plotted in blue. Each point is a portion of a single trajectory. The ensemble distribution is plotted in light blue.}}{88}{figure.caption.62}%
\contentsline {figure}{\numberline {8.15}{\ignorespaces DLS measurements of LNP samples. The blue, green and orange plot denote the liposomal, $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully.}}{89}{figure.caption.64}%
\contentsline {figure}{\numberline {8.16}{\ignorespaces Probability histogram of LNP axial position. Plotted in green and orange are the $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully. The liposomal, LNPs were too small to be tracked over a long-range and are hence omitted.}}{90}{figure.caption.66}%
\contentsline {figure}{\numberline {8.17}{\ignorespaces Ensemble MSD of LNP formalations. Plotted in blue and green are the $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully. The lag time, $\tau $ is plotted in frame indices. Each unit of $\tau $ represents one frame at $\SI {400}{\fps }$. The red line in the right-plot display the expected MSD plateaus for particles of radius $20, 50\mathrm { nm}$ in order of increasing boldness. The $25\mathrm { mM}$ NaAC traces contain ensemble information of 3 traces. The $300\mathrm { mM}$ NaAC traces contain ensemble information of 2 traces.}}{91}{figure.caption.67}%
