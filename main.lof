\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Size comparison of various particles. Nanoparticles are defined as particles where the largest dimension is at most $\sim 200 \mathrm {nm}$. Figures taken from "Comparison of nanomaterials sizes" by Sureshbup, available under CC BY-SA 3.0 at \href {https://commons.wikimedia.org/wiki/File:Comparison_of_nanomaterials_sizes.jpg}{URL}}}{2}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Linear-superposition mobility curve for linear-superposition and Faxén relations with $h = \SI {225}{\nm }$.}}{12}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Cost-vector for self-consistent diffusion estimation in confinement. Here, a $\sim \SI {100}{\nm }$ polystyrene bead was imaged and tracked in the transverse plane. The initial size estimate before confinement analysis was $\hat {a} = \SI {124.30}{\nm }$. Post self-consistency, applying a linear superposition theory estimate of the confinement effects, $a^* = \SI {64.1}{\nm }$.}}{12}{figure.caption.12}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Lipid nanoparticle diagram and CRYO-EM image. CRYO-EM image obtained from the NIST Segmentation of Lipid Nanoparticles \href {https://data.nist.gov/od/id/mds2-2753}{dataset} \blx@tocontentsinit {0}\cite {NIST2023}. Shown are KC2 LNPs at pH 7, with RNA taken at $\SI {0.223}{\nm }$ per pixel.}}{17}{figure.caption.13}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces mRNA-LNP types diagram. Black is lipids, grey is hydrophobic region, red is mRNA, orange is oil-core. Taken from Fig. 2 of Simonsen, 2024 \blx@tocontentsinit {0}\cite {Simonsen2024}. Creative Commons license.}}{18}{figure.caption.14}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Locating encapsulated mRNA in LNPs by cryo-EM. Taken directly from Kloczewiak, 2022\blx@tocontentsinit {0}\cite {Kloczewiak2022}. Creative Commons license.}}{18}{figure.caption.15}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Rayleigh scattering pattern, Eqn. \ref {eqn:rayleigh_scat}, plotted for various sized particles. Parameters fixed such that $\lambda = \SI {405}{\nm }, n_m = 1.33, E_0 = 1, \theta = 0$. Particle parameters set as $n_p = 1.59, \alpha \propto V$. As the particle volume increases, the scattering pattern increases in amplitude.}}{23}{figure.caption.16}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Simple imaging setup. Left, a lens is placed before an object. The light focuses on an imaging plane. The schematic consists of a feasible setup. Right, an image consists of a plane wave illumination, a lens, and a camera.}}{27}{figure.caption.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Isometric iSCAT Schematic. A laser is first shaped using a spatial filter for a gaussian beam profile. The gaussian beam is sized by an aperture and focused into the back-plane of an objective. During the focusing, the light is circularily polarized. At the sample plane, two coverslips are placed for sample containment. To control the gap between the two coverslips, the convex-lens induced confinement (CLiC) system is used. The scattered and reflected light is collected through a polarizing beam-splitter and the final image is focused on a CMOS camera array.}}{32}{figure.caption.19}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Optical table for the iSCAT microscope. Photographed at the Leslie lab, UBC.}}{33}{figure.caption.20}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Optical table for the iSCAT microscope. Photographed at the Leslie lab, UBC.}}{33}{figure.caption.21}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Laser Driver for the $\SI {405}{\nm }$ laser diode. }}{34}{figure.caption.22}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Model diagram of simulation geometry. A spherical particle of radius $a$ is modeled between two charged parallel plates. The electrostatic potential, modelled by the Debye-Hückel screened electrostatic interactions, are drawn in a blue gradient.}}{39}{figure.caption.24}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Langevin simulation function \textsc {StepTraj} time complexity. Simulation parameters are set as default with $dt = 2\cdot 10^{-7}$. The number of simultaneous particles is $1$, and the number of recorded positions consists of all of the points in the trajectory. In big-O notation, the time complexity is $\mathcal {O}\left (n^1\right )$. Simulations performed on a 2020 MacBook Pro with ARM M1 processor.}}{42}{figure.caption.27}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Langevin simulation function \textsc {StepTraj} time complexity. Simulation parameters are set as Fig. \ref {fig:timecomplex1} with two parallel simulations.}}{42}{figure.caption.28}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Confined Brownian Particle realization of $z$ diffusion in electrostatic potential. The step-histogram is plotted in green. Simulation input parameters are $a = \SI {50}{\nm }, \zeta _p = \SI {-3.5}{\milli \volt }, \sigma _w = \SI {-2}{\milli \coulomb / \meter ^2}, L = \SI {225}{\nm }, \lambda _D = \SI {100}{\nm }, T = \SI {300}{\kelvin }, \eta = \SI {1}{\milli \pascal \second }$.}}{43}{figure.caption.29}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Comparison between MSD curves of two different charged particles. The green trace represents a neutrally charged particle with a maximal MSD of $\sim \SI {26000}{\nm ^2}$. The blue trace represents a negatively charged particle with a maximal MSD of $\sim \SI {15000}{\nm ^2}$. The chart on the right shows the transverse MSD of the two particles. Each unit of $\tau $ consists of on exposure time of $\SI {200}{\micro \second }$. The debye-length was fixed to $\lambda _D = \SI {10}{\nm }$. }}{44}{figure.caption.30}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Effective confinement length $L$, or the minimum and maximum trajectory axial position, plotted against the solution's debye-length $\lambda _D$ and expressed in terms of ion concentration $C$.}}{45}{figure.caption.31}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Effective diffusion $D/D_0$, or the measure diffusion coefficient compared to the input diffusion, plotted against the solution's Debye length expressed as concentration $C$ of ions. }}{46}{figure.caption.32}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Effective confinement plotted against the particle's zeta-potential.}}{47}{figure.caption.33}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Distribution of $\hat {B}$ Re-parameterized for the surface charge. $\hat {\sigma } = 1/(A\cdot C)^2 \hat {B}$ where $A,C$ are properly defined in \ref {eqn:electrostatic_forces}.}}{48}{figure.caption.34}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Outline of the 3D particle-tracking pipeline.}}{50}{figure.caption.35}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Raw image captured on camera to background subtracted iSCAT image. Single particles are tracked and extracted for further analysis.}}{51}{figure.caption.36}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Raw image to RVT. Gaussian fitting of the RVT is shown on both plots.}}{52}{figure.caption.37}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Demonstration of the Radial Symmetry method applied onto RVT of iSCAT data. Implemented from \blx@tocontentsinit {0}\cite {parthasarathyRapidAccurateParticle2012}. Figure adapted from \blx@tocontentsinit {0}\cite {parthasarathyRapidAccurateParticle2012}. }}{53}{figure.caption.38}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Angular Integral demonstration on experimental polystyrene image. The polar distance, $\rho $ is plotted here where the red $\times $ symbol denotes the center of the image.}}{54}{figure.caption.39}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Simulated iPSF. Left. Projection of in-focus plane. Middle. $x,z$ projection. Right. $y,z$ projection. Focal scan is over $\SI {400}{\nm }$. pixel size is $\SI {55}{\nm }/\text {pixel}$. $\lambda = \SI {405}{\nm }$. Assumed particle radius $a = \SI {50}{\nm }$.}}{57}{figure.caption.41}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Viterbi Search algorithm toy example. Optimal path is chosen based on $z$ similarity and lowest loss.}}{57}{figure.caption.40}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Nuisance Parameter estimation for iPSF fits. Left. Amplitude factor. right. exponential decay factor. The exponential decay is not of utmost importance as it often is very small. it is kept for stability purposes.}}{58}{figure.caption.42}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Fit residuals using no weighting scheme. reporting an absolute bias of 1 nm with variance of 2 nanometers.}}{59}{figure.caption.43}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {8.1}{\ignorespaces Schematic of iSCAT system from Chap. \ref {chap:iscatsetup}. See \ref {fig:schematic} for details.}}{62}{figure.caption.45}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces Flow cell schematic. Left, diagram of flow-cell with sticker. Right, top and bottom coverslips of the flow cell separated.}}{63}{figure.caption.46}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces flow-cell schematic and assembled flow-cell photograph.}}{63}{figure.caption.47}%
\contentsline {figure}{\numberline {8.4}{\ignorespaces Convex-lens induced confinement schematic. Two glass coverslips, separated by a $\SI {30}{\micro \meter }$ spacer are confined with a convex-lens pusher. The height between the coverslips is voltage-regulated to nanometer precision. Nanoparticle of radius $\SI {50}{\nm }$ pictured for reference.}}{65}{figure.caption.48}%
\contentsline {figure}{\numberline {8.5}{\ignorespaces DLS results for Polystyrene beads in MilliQ water.}}{65}{figure.caption.49}%
\contentsline {figure}{\numberline {8.6}{\ignorespaces Spatial density of the average trajectory of particles. }}{67}{figure.caption.52}%
\contentsline {figure}{\numberline {8.7}{\ignorespaces Probability density for three different concentrations of PBS. The blue line has a concentration of $0.1\%$ PBS, green has a concentration of $0.01\%$ PBS, and orange has a concentration of $0.00001\%$ PBS. The horizontal axis is the $z$-axis position of the particle. The vertical axis is the frequency of position measurement.}}{68}{figure.caption.53}%
\contentsline {figure}{\numberline {8.8}{\ignorespaces Relationship between the FWHM and $a_{xy}$, where FWHM is the full-width half maximum of the positional histogram, and $a_{xy}$ is the particle radius.}}{69}{figure.caption.54}%
\contentsline {figure}{\numberline {8.9}{\ignorespaces Plotted is the radius estimated by axial exploration compared to inferred transverse size of particles for various ionic concentrations. }}{70}{figure.caption.55}%
\contentsline {figure}{\numberline {8.10}{\ignorespaces Surface charge estimation via MLE of $\SI {100}{\nm }$ polystyrene beads in 0.00001\% PBS solution. Imaging conducted at $\SI {400}{\fps }$.}}{71}{figure.caption.56}%
\contentsline {figure}{\numberline {8.11}{\ignorespaces Glycerol-water curve. The theoretical line plotted is used from Cheng et al. \blx@tocontentsinit {0}\cite {cheng_formula_2008}.}}{72}{figure.caption.58}%
\contentsline {figure}{\numberline {8.12}{\ignorespaces Trajectory of a polystrene bead in glycerol. The red dot and blue square show the initial and final position respectfully.}}{73}{figure.caption.59}%
\contentsline {figure}{\numberline {8.13}{\ignorespaces Mean-squared displacement of glycerol-slowed polystyrene beads. Axial MSD is clearly convergent to the confinement length. The confinement length is fixed at $225$ nm and the particle's estimated size is $a=\SI {50}{\nm }$. The lag time, $\tau $ is plotted in frame indices. Each unit of $\tau $ represents one frame at $\SI {580}{\fps }$.}}{74}{figure.caption.60}%
\contentsline {figure}{\numberline {8.14}{\ignorespaces Theoretical diffusivity shown in orange using the linear-superposition theory (LST). Measured diffusivity of $7$ particle traces are plotted in blue. Each point is a portion of a single trajectory. The ensemble distribution is plotted in light blue.}}{75}{figure.caption.61}%
\contentsline {figure}{\numberline {8.15}{\ignorespaces DLS measurements of LNP samples. The blue, green and orange plot denote the liposomal, $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully.}}{76}{figure.caption.63}%
\contentsline {figure}{\numberline {8.16}{\ignorespaces Probability histogram of LNP axial position. Plotted in green and orange are the $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully. The liposomal, LNPs were too small to be tracked over a long-range and are hence omitted.}}{77}{figure.caption.65}%
\contentsline {figure}{\numberline {8.17}{\ignorespaces Ensemble MSD of LNP formalations. Plotted in blue and green are the $25\mathrm { mM}$ NaAC, and $300\mathrm { mM}$ NaAC LNP formulations respectfully. The lag time, $\tau $ is plotted in frame indices. Each unit of $\tau $ represents one frame at $\SI {400}{\fps }$. The red line in the right-plot display the expected MSD plateaus for particles of radius $20, 50\mathrm { nm}$ in order of increasing boldness. The $25\mathrm { mM}$ NaAC traces contain ensemble information of 3 traces. The $300\mathrm { mM}$ NaAC traces contain ensemble information of 2 traces.}}{78}{figure.caption.66}%
