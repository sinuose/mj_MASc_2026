\contentsline {figure}{\numberline {6.1}{\ignorespaces Model diagram of simulation geometry. A spherical particle of radius $a$ is modeled between two charged parallel plates. }}{36}{figure.caption.23}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Langevin simulation function \textsc {StepTraj} time complexity. Simulation parameters are set as default with $dt = 2\cdot 10^{-7}$. The number of simultaneous particles is $1$, and the number of recorded positions consists of all of the points in the trajectory. In big-O notation, the time complexity is $\mathcal {O}\left (n^1\right )$. Simulations performed on a 2020 MacBook Pro with ARM M1 processor.}}{39}{figure.caption.26}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Langevin simulation function \textsc {StepTraj} time complexity. Simulation parameters are set as Fig. \ref {fig:timecomplex1} with two parallel simulations.}}{39}{figure.caption.27}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Confined Brownian Particle realization of $z$ diffusion in electrostatic potential. The step-histogram is plotted in green. Simulation input parameters are $a = \SI {50}{\nm }, \zeta _p = \SI {-3.5}{\milli \volt }, \sigma _w = \SI {-2}{\milli \coulomb / \meter ^2}, L = \SI {225}{\nm }, \lambda _D = \SI {100}{\nm }, T = \SI {300}{\kelvin }, \eta = \SI {1}{\milli \pascal \second }$.}}{40}{figure.caption.28}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Comparison between MSD curves of two different charged particles. The green trace represents a neutrally charged particle with a maximal MSD of $\sim \SI {26000}{\nm ^2}$. The blue trace represents a negatively charged particle with a maximal MSD of $\sim \SI {15000}{\nm ^2}$. The chart on the right shows the transverse MSD of the two particles. Exposure time $\tau = \SI {200}{\micro \second }$, $\lambda _D = \SI {10}{\nm }$. }}{41}{figure.caption.29}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Effective Confinement length plotted against the solution's Debye-length.}}{42}{figure.caption.30}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Effective diffusion plotted against the solution's Debye length. }}{43}{figure.caption.31}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Effective confinement plotted against the particle's zeta-potential.}}{44}{figure.caption.32}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Distribution of $\hat {B}$ Re-parameterized for the surface charge. $\hat {\sigma } = 1/(A\cdot C)^2 \hat {B}$ where $A,C$ are properly defined in \ref {eqn:electrostatic_forces}.}}{45}{figure.caption.33}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Outline of the 3D particle-tracking pipeline.}}{47}{figure.caption.34}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Raw image captured on camera to background subtracted iSCAT image. Single particles are tracked and extracted for further analysis.}}{48}{figure.caption.35}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Raw image to RVT. Gaussian fitting of the RVT is shown on both plots.}}{49}{figure.caption.36}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Demonstration of the Radial Symmetry method applied onto RVT of iSCAT data. Implemented from \blx@tocontentsinit {0}\cite {parthasarathyRapidAccurateParticle2012}. Figure adapted from \blx@tocontentsinit {0}\cite {parthasarathyRapidAccurateParticle2012}. }}{50}{figure.caption.37}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Angular Integral demonstration.}}{51}{figure.caption.38}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Viterbi Search algorithm toy example. Optimal path is chosen based on $z$ similarity and lowest loss.}}{53}{figure.caption.39}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Simulated iPSF. Left. Projection of in-focus plane. Middle. $x,z$ projection. Right. $y,z$ projection. Focal scan is over $\SI {400}{\nm }$. pixel size is $\SI {55}{\nm }/\text {pixel}$. $\lambda = \SI {405}{\nm }$. Assumed particle radius $a = \SI {50}{\nm }$.}}{54}{figure.caption.40}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Nuisance Parameter estimation for iPSF fits. Left. Amplitude factor. right. exponential decay factor. The exponential decay is not of utmost importance as it often is very small. it is kept for stability purposes.}}{55}{figure.caption.41}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Fit residuals using no weighting scheme. reporting an absolute bias of 1 nm with variance of 2 nanometers.}}{56}{figure.caption.42}%
