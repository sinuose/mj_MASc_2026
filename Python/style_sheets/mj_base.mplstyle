# science_dhm.mplstyle
# APS/PRL-style single-column figures. Works for 2D and 3D axes.
# Usage:  plt.style.use('science_dhm.mplstyle')

# ---- color cycle: blue, green, yellow, red, violet, grays ----
axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])

# ---- canvas: single-column panel proportions ----
figure.figsize : 5, 5

figure.dpi     : 300
savefig.dpi    : 600

# ---- type sizes (large relative to the small panels) ----
font.size       : 8
axes.labelsize  : 9
xtick.labelsize : 8
ytick.labelsize : 8
legend.fontsize : 7

# ---- x axis ----
xtick.direction     : in
xtick.major.size    : 3
xtick.major.width   : 0.5
xtick.minor.size    : 1.5
xtick.minor.width   : 0.5
xtick.minor.visible : True
xtick.top           : True
xtick.major.pad     : 2.5

# ---- y axis ----
ytick.direction     : in
ytick.major.size    : 3
ytick.major.width   : 0.5
ytick.minor.size    : 1.5
ytick.minor.width   : 0.5
ytick.minor.visible : True
ytick.right         : True
ytick.major.pad     : 2.5

# ---- line / spine widths ----
axes.linewidth : 0.5
grid.linewidth : 0.5
lines.linewidth : 1.

# ---- markers and error bars (panels f, g) ----
lines.markersize      : 4
lines.markeredgewidth : 0.6
errorbar.capsize      : 2

# ---- legend ----
legend.frameon       : False
legend.handlelength  : 1.2
legend.handletextpad : 0.4
legend.borderaxespad : 0.5

# ---- saving ----
savefig.bbox       : tight
savefig.pad_inches : 0.05

# ---- fonts / math via LaTeX ----
font.family : serif
text.usetex : True
# Times for text + math (APS house style). If newtx is not installed and this
# errors, delete the two newtx packages below to fall back to Computer Modern.
text.latex.preamble : \usepackage{amsmath}\usepackage{amssymb} #\usepackage{newtxtext}\usepackage{newtxmath}